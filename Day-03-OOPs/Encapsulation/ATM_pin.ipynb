    "class ATM:\n",
    "\n",
    "    def __init__(self):\n",
    "        self.__pin = 1234\n",
    "\n",
    "    def verify_pin(self, entered_pin):\n",
    "        if entered_pin == self.__pin:\n",
    "            print(\"PIN Verified\")\n",
    "        else:\n",
    "            print(\"Incorrect PIN\")\n",
    "\n",
    "\n",
    "atm = ATM()\n",
    "\n",
    "atm.verify_pin(1234)\n",
    "atm.verify_pin(1111)"
   ]
  }
