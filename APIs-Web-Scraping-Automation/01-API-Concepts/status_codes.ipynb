   "source": [
    "status_codes = {\n",
    "    200: \"Success\",\n",
    "    201: \"Created\",\n",
    "    400: \"Bad Request\",\n",
    "    401: \"Unauthorized\",\n",
    "    403: \"Forbidden\",\n",
    "    404: \"Not Found\",\n",
    "    500: \"Server Error\"\n",
    "}\n",
    "\n",
    "for code, meaning in status_codes.items():\n",
    "    print(code, \"->\", meaning)"
   ]
  }
 ],
