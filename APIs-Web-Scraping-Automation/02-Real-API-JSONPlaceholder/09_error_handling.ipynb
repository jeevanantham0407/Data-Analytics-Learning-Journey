   "source": [
    "import requests\n",
    "\n",
    "url = \"https://jsonplaceholder.typicode.com/users/9999\"\n",
    "\n",
    "response = requests.get(url)\n",
    "\n",
    "print(\"Status Code:\", response.status_code)\n",
    "\n",
    "if response.status_code == 200:\n",
    "    user = response.json()\n",
    "    print(user)\n",
    "else:\n",
    "    print(\"Request failed\")"
   ]
  }
